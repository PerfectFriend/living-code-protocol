# Протокол Живого Кода: скрипты оркестрации — часть репозитория
# (Projects/ — отдельные репозитории, не попадают сюда)
Projects/*/
Project1/
Project2/
Project3/
Project4/
Releases/

# Компилированный код
__pycache__/
*.pyc
*.pyo
*.so
node_modules/
*.exe
/target/
*.rs.bak
.dart_tool/
build/

# Система
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Локальное окружение
.env
.env.local
*.key
*.pem
*.crt

# Hermes
.hermes/

# Логи
*.log
logs/

# Временные файлы
*.tmp
scratch/
.tmp/

# Большие бинарники — в ~/apkexport, не в репозитории
*.apk
*.aab

# IDE
.idea/
.vscode/
*.code-workspace

# vigiles audit report (generated)
vigiles-report.json
vigiles-report.html

#!/bin/bash
# Обёртка Кодера Project2 — слот 1 час (ротация раз в 4 часа).
# Ψ-FIX 19.10.2026: промпт вынесен из инлайн-heredoc в wrappers/prompts/project2.txt
# (инлайн жил своей жизнью: слот 45 минут, мёртвый hermes send, триггер "project2" в
# нижнем регистре, NEXT_JOB_ID на мёртвый bf9ae9bb523d). Теперь: слот 1 час, кодер
# работает только внутри ~/LivingCode/Project2 и коммитит в его собственный git.
# Пуш делает cycle_close.py в конце цепочки.
set -o pipefail
DIR=/home/thomas/LivingCode/orchestration/scripts
export LIVING_CODE_CRON_BUDGET=4000

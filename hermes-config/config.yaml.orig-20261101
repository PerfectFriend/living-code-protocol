auxiliary:
  compression:
    # 2026-10-29: реальное окно компрессора. Nemotron Lightning держит 838k входа
    # (проверено живым прогоном), 262144 безопасно.
    context_length: 262144
    # Локальная llama.cpp отключена (VRAM/swap). Компрессор = NVIDIA Nemotron Lightning.
    # ВАЖНО: model:'' + provider:auto отправляли сжатие на ОСНОВНУЮ модель с окном
    # 65536 → «Compacting context…» по кругу до таймаута 1800s. Только явный рабочий id.
    model: nvidia/nemotron-3.5-super-vl-120b-a12b
    provider: nvidia
    timeout: 900
    no_progress_timeout: 300
browser:

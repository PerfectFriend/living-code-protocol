compression:
  checkpoint_required: false
  codex_app_server_auto: native
  codex_gpt55_autoraise: true
  codex_responses_compact_threshold:
  codex_responses_native: false
  # 2026-10-04: Nemotron 3.5 Lightning 30B-A3B — удалённый компрессор сессий.
  # Живой тест: 3.2 с, чистый вывод. ВАЖНО: id требует префикс "nvidia/" (без него 404).
  compressor_model: nvidia/nemotron-3.5-super-vl-120b-a12b
  enabled: true
  hygiene_max_turn_hold_seconds: 10
  idle_compact_after_seconds: 0
  max_attempts: 3
  min_tail_user_messages: 1
  proactive_prune_min_reclaim_tokens: 4096
  proactive_prune_min_result_chars: 8000
  proactive_prune_tokens: 0
  progress_notices: false
  protect_first_n: 3
  protect_last_n: 20
  target_ratio: 0.2
  # Было 0.5: сжатие срабатывало на 32768 токенов, но protect_last_n:20 не даёт
  # ужать единственное пользовательское сообщение → "couldn't shrink it enough",
  # хотя запрос (41 806 токенов) отлично влезает в 65536. Теперь жмём только
  # у реального предела 80% = 52428 токенов.
  threshold: 0.8
  threshold_tokens: 200000
